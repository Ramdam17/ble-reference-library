{
  "name": "ble-reference-web",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Bluetooth TypeScript reference library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
